#ifndef TCNP_VERSION_H
#define TCNP_VERSION_H

/*
 * Generated by CMake from version= in src/pluginst.inf, the single source of truth for the plugin
 * version. Edit pluginst.inf, never the generated build/<arch>/version.h.
 */
#define TCNP_VER_MAJOR      @TCNP_VER_MAJOR@
#define TCNP_VER_MINOR      @TCNP_VER_MINOR@
#define TCNP_VER_PATCH      @TCNP_VER_PATCH@

#define TCNP_VERSION_CSV    @TCNP_VER_MAJOR@,@TCNP_VER_MINOR@,@TCNP_VER_PATCH@,0
#define TCNP_VERSION_STR    "@TCNP_VER_MAJOR@.@TCNP_VER_MINOR@.@TCNP_VER_PATCH@.0"
#define TCNP_PRODUCT_VER    "@TCNP_VERSION@"  /* as in pluginst.inf, e.g. "1.2.1-devel" */

/* TCNewPlus.wfx (32-bit) or TCNewPlus.wfx64 (64-bit): the name Total Commander requires per bitness */
#define TCNP_FILE_NAME      "@TCNP_FILE_NAME@"

#endif /* TCNP_VERSION_H */
