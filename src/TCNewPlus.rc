// UTF-8 source: the strings below contain non-ASCII characters
#pragma code_page(65001)

#include <winresrc.h>
#include "version.h"

// Total Commander shows the FIRST icon (by resource index) found in a File
// System plugin DLL next to the plugin's name in Network Neighborhood. The
// low numeric ID keeps this icon first.
1 ICON "TCNewPlus.ico"

// Version resource: shown in the file's properties and read by Total
// Commander's Plugin Manager. The numbers come from version= in pluginst.inf
// (see CMakeLists.txt).
#ifdef _DEBUG
#define VER_FILEFLAGS VS_FF_DEBUG
#else
#define VER_FILEFLAGS 0x0L
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TCNP_VERSION_CSV
PRODUCTVERSION  TCNP_VERSION_CSV
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_FILEFLAGS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Michal Růžička Hobby Development\0"
            VALUE "FileDescription",  "TCNewPlus – New+ style file templates for Total Commander (WFX)\0"
            VALUE "FileVersion",      TCNP_VERSION_STR "\0"
            VALUE "InternalName",     TCNP_FILE_NAME "\0"
            VALUE "LegalCopyright",   "Copyright 2026 Michal Růžička. Licensed under the Apache License 2.0.\0"
            VALUE "OriginalFilename", TCNP_FILE_NAME "\0"
            VALUE "ProductName",      "TCNewPlus\0"
            VALUE "ProductVersion",   TCNP_PRODUCT_VER "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
